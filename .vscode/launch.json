{
  // Run / debug WeedScan from VS Code (Run and Debug panel, or F5).
  // Jetson/Linux: the SYSTEM /usr/bin/python3 (where the ZED SDK installed pyzed).
  // Windows laptop: the interpreter selected in VS Code (bottom-right) - pick the one where
  // `import pyzed.sl` works (the one you ran get_python_api.py with).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WeedScan GUI (VS Code running on the Jetson desktop)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/bin/python3",
      "windows": { "python": "${command:python.interpreterPath}" },
      "program": "${workspaceFolder}/Zed2i_video_datacollection.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "WeedScan GUI on the Jetson monitor (VS Code Remote-SSH from a laptop)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/bin/python3",
      "windows": { "python": "${command:python.interpreterPath}" },
      "program": "${workspaceFolder}/Zed2i_video_datacollection.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // The window opens on the screen attached to the Jetson (you must be logged in there).
      // If it fails with "couldn't connect to display", run `ls /tmp/.X11-unix` on the Jetson
      // and use :1 instead of :0 if you see X1.
      "env": { "DISPLAY": ":0", "XAUTHORITY": "/run/user/1000/gdm/Xauthority" }
    },
    {
      "name": "Headless recorder (terminal only, works over SSH)",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/bin/python3",
      "windows": { "python": "${command:python.interpreterPath}" },
      "program": "${workspaceFolder}/record_headless.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--plot", "${input:plot}", "--operator", "${input:operator}",
               "--height", "${input:height}", "--lock-auto", "5"]
    },
    {
      "name": "Doctor: check setup",
      "type": "debugpy",
      "request": "launch",
      "python": "/usr/bin/python3",
      "windows": { "python": "${command:python.interpreterPath}" },
      "program": "${workspaceFolder}/zed_doctor.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": ["--quick"]
    }
  ],
  "inputs": [
    { "id": "plot", "type": "promptString", "description": "Plot / row ID", "default": "A1" },
    { "id": "operator", "type": "promptString", "description": "Operator initials", "default": "" },
    { "id": "height", "type": "promptString", "description": "Lens height above ground (m)", "default": "1.0" }
  ]
}
